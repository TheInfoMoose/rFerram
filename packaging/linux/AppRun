#!/usr/bin/env bash
# rFerram AppImage Entrypoint (AppRun)
set -euo pipefail

APPDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export APPDIR
export PATH="${APPDIR}/usr/bin:${PATH:-/usr/bin:/bin}"
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

INVOKED_NAME="$(basename "${ARGV0:-$0}")"
if [[ "${INVOKED_NAME}" == "rferram-server" ]]; then
    exec "${APPDIR}/usr/bin/rferram-server" "$@"
fi

if [[ "${1:-}" == "--server" || "${1:-}" == "--daemon" ]]; then
    shift
    exec "${APPDIR}/usr/bin/rferram-server" "$@"
fi

exec "${APPDIR}/usr/bin/rferram-ui" "$@"
